     C**************************************************************************
     C* VORLAUFKARTEN
     C**************************************************************************
     C           *ENTRY    PLIST
     C                     PARM           MD
     C                     PARM           X       20
     C*
     C                     EXSR MODATR
     C                     MOVEAMD        TXT   256
     C                     MOVELATR,X     MD,1
     C                     MOVEATXT       MD,2
     C                     MOVE '1'       *INLR
     C*
     C**************************************************************************
     C* MODATR: VARIABLE STEUERUNG DER FELDATTRIBUTE/FELDGRUPPE FÜLLEN
     C**************************************************************************
     C*
     C           MODATR    BEGSR
     C                     CLEARATR
     C                     CALL '#MODATR'              97
     C                     PARM           ATR
     C                     ENDSR
     C*
