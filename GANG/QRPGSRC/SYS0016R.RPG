     C*-------------------------------------------------------------------------
     C*
     C           SR1801    BEGSR
     C*
     C           S1F1RR    IFNE *ZERO
     C                     MOVE 'U'       CTLMOD           MODUS UPDATE
     C           S1F1RR    CHAIN§000PHY1             91
     C                     EXSR SR1502
     C                     ELSE
     C                     MOVE 'W'       CTLMOD           MODUS WRITE
     C                     CLEARPHY01R
     C                     END
     C                     EXSR SR1505
