     C                     EXSR SR1526
     C           S1F1RR    IFNE *ZERO
     C           CTLMOD    ANDEQ' '
     C                     UNLCK§000PHY1                   ENTSPERREN
     C                     ENDIF
     C*
     C           CTLMOD    IFNE ' '
     C                     MOVELKEYFMT    KEYDAT           IN DATA-AREA
     C                     MOVELD3DESC    S5DESC
     C                     MOVELD3BERE    S5BERE
