     C                     MOVE 'J'       CTLLD
     C                     MOVELI§§010    IMSG03
     C                     EXSR MSG001
     C                     ELSE
     C                     MOVELLDADTP    S5EDAT
     C                     MOVELLDADTP    H1EDAT
