WITH X (HEUTE) AS
     (SELECT INT(INT(YEAR(CURRENT DATE) * 10000) +
                 INT(MONTH(CURRENT DATE) * 100) +
                 INT(DAY(CURRENT DATE)))
      FROM   SYSIBM/SYSDUMMY1)
--
SELECT LI.KOBEGR, LI.KOPRGR, LI.KOKDLI, LI.KOKDLG,
       COALESCE(RE.KOBEGR, ' '),
       COALESCE(RE.KOPRGR, ' '),
       COALESCE(RE.KOKDLI, ' '),
       COALESCE(RE.KOKDLG, ' ')
FROM   KOND LI, X
--LEFT   OUTER JOIN KOND RE
INNER JOIN KOND RE
ON     LI.KOFIRM = RE.KOFIRM AND
       LI.KOPRGR = RE.KOPRGR AND
       RE.KOBEGR IN ('RP2', 'RP4', 'RP6') AND
       (LI.KOKDLI <> ' ' AND LI.KOKDLI = RE.KOKDLI OR
        LI.KOKDLG <> ' ' AND LI.KOKDLG = RE.KOKDLG) AND
       (RE.KOGADA = 0 OR RE.KOGADA <= HEUTE) AND
       (RE.KOGBDA = 0 OR RE.KOGADA >= HEUTE)
WHERE  (LI.KOGADA = 0 OR LI.KOGADA <= HEUTE)
  AND  (LI.KOGBDA = 0 OR LI.KOGADA >= HEUTE)
  AND  LI.KOBEGR IN ('RP1', 'RP3', 'RP5')
ORDER  BY LI.KOFIRM, LI.KOBEGR, LI.KOPRGR
