     C                   MOVE      *BLANK        WKPROG                         PROGRAMM
     C                   MOVE      *BLANK        WKBIBL                         BIBLIOTHEK
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  RESTORE FELDER USERZUGRIFF                                        ***
     C**************************************************************************
     C     RZUGR         BEGSR
     C*
     C*-------------------------------------------------------------------------
     C     WKUSER        IFNE      *BLANK
     C                   MOVEL(P)  WKJNAM        WA20JNAM                       JOBNAME
     C                   Z-ADD     WKJDAT        WA20JDAT                       JOBDATUM
     C                   Z-ADD     WKJZEI        WA20JZEI                       JOBZEIT
     C                   MOVEL(P)  WKUSER        WA20USER                       USER
     C                   MOVEL(P)  WKPROG        WA20PROG                       PROGRAMM
