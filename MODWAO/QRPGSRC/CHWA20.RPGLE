     C     UDADS         BEGSR
     C*
     C*-------------------------------------------------------------------------
     C                   MOVEL(P)  'L'           WKCHRT                         FELDER FÜR
     C                   MOVEL(P)  WA20JNAM      DSJNAM                         ANZEIGE 'SATZ
     C                   MOVEL(P)  WA20PROG      DSPROG                         WIRD BENUTZT
     C                   MOVEL(P)  WA20BIBL      DSBIBL                         DURCH ...'
     C                   MOVEL(P)  WA20USER      DSUSER                         FÜLLEN
     C                   Z-ADD     WA20JZEI      DSJZEI
     C                   Z-ADD     WA20JDAT      DSJDAT
