     H DECEDIT('0,') DATEDIT(*DMY.)
     H OPTION(*SRCSTMT : *NODEBUGIO)
     H**************************************************************************
     H/TITLE Übernahme Absatz-Plan Erhöhungstabelle
     F**************************************************************************
     F*
     F*  Dieses Programm übernimmt die Absatz-Plan Erhöhungstabelle
     F*
     F**************************************************************************
     F***  DATEIBESCHREIBUNGEN                                               ***
     F**************************************************************************
     FPARAM     IF   E             DISK
     F                                     RENAME(PARAM:PARAM1)
     F*
     D**************************************************************************
     D***  T A B E L L E N   U N D   F E L D G R U P P E N                   ***
     D**************************************************************************
     D/COPY QCPYSRC,EXTRBR
     D*
     D**************************************************************************
     D***  DATEIEN                                                           ***
     D**************************************************************************
     D WAOK          E DS                  INZ
     D KYWAOK        E DS                  INZ
     D*
     D TRPA          E DS                  INZ
     D KYTRPA        E DS                  INZ
     D*
     D**************************************************************************
     D***  KOMMUNIKATIONSPARAMETER                                           ***
     D**************************************************************************
     D EXTR01        E DS                  INZ
     D EXTR02        E DS                  INZ
     D EXTR03        E DS                  INZ
     D*
     D EXWAOK        E DS                  INZ
     D RTWAOK        E DS                  INZ
     D*
     D**************************************************************************
     D***  DATENSTATIONSARBEITSBEREICH                                       ***
     D**************************************************************************
     D EXTRLD        EUDS
     D*
     D**************************************************************************
     D***  INTERNE DATENSTRUKTUR                                             ***
     D**************************************************************************
     D/COPY QCPYSRC,EXTRIN
     D*
     D  WKTDAT                         D   DATFMT(*ISO) INZ
     D*
     D**************************************************************************
     D***  PROGRAMMSTATUS DATENSTRUKTUR                                      ***
     D**************************************************************************
     D/COPY QCPYSRC,EXPSDS
     D*
     C**************************************************************************
     C***  R E C H E N B E S T I M M U N G E N                               ***
     C**************************************************************************
     C     *DTAARA       DEFINE    *LDA          EXTRLD
     C                   IN        EXTRLD
     C*-------------------------------------------------------------------------
     C     WKI000        CASNE     *ON           ANFANG
     C                   ENDCS
     C*-------------------------------------------------------------------------
     C     WKTRPA        CASNE     *ON           ETRPA
     C                   ENDCS
     C*-------------------------------------------------------------------------
     C                   EXSR      VORLAUF
     C**************************************************************************
     C***  P R O G R A M M S T E U E R U N G                                 ***
     C**************************************************************************
     C                   EXSR      VWAOK
     C*-------------------------------------------------------------------------
     C                   MOVE      *ON           *INLR
     C**************************************************************************
     C***  ERÖFFNUNGSZYKLUS                                                  ***
     C**************************************************************************
     C     ANFANG        BEGSR
     C*
     C                   MOVE      *ON           WKI000
     C*-------------------------------------------------------------------------
     C                   MOVE      *BLANK        WKC001            1
     C                   Z-ADD     *ZERO         WKN010            1 0
     C*-------------------------------------------------------------------------
     C                   MOVEL(P)  DAFIRM        KYWAOKFIRM                     WAOK
     C                   MOVEL(P)  DAFIRM        KYTAFI                         TRPA
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  VORLAUF                                                           ***
     C**************************************************************************
     C     VORLAUF       BEGSR
     C*
     C*-------------------------------------------------------------------------
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  ERMITTELN PARAMETERWERTE                                          ***
     C**************************************************************************
     C     ETRPA         BEGSR
     C*
     C                   MOVEL     *ON           WKTRPA
     C*-------------------------------------------------------------------------
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  SPEICHERN ERHÜHUNGSTABELLE <- KD-STEUERUNGS-CODE/PRODUKT-GRUPPE   ***
     C**************************************************************************
     C     VWAOK         BEGSR
     C*
     C*-------------------------------------------------------------------------
     C                   MOVE      *OFF          *IN
     C*-------------------------------------------------------------------------
     C     *IN(98)       DOWEQ     *OFF
     C     *IN(99)       ANDEQ     *OFF
     C*-------------------------------------------------------------------------
     C                   READ      PARAM1                               9899
     C*
     C     *IN(98)       IFEQ      *ON
     C     *IN(99)       OREQ      *ON
     C                   LEAVE
     C                   ENDIF
     C*-------------------------------------------------------------------------
     C                   CLEAR                   EXWAOK
     C*
     C                   SELECT
     C*--------------------------------------------------------
     C                   WHEN      %LEN(%TRIM(F1)) = 1
     C                   EVAL      EXWAOKKSTC  = %SUBST(F1:1:1) + '01'
     C*--------------------------------------------------------
     C                   WHEN      %LEN(%TRIM(F1)) = 2
     C                   EVAL      EXWAOKKSTC  = %SUBST(F1:1:1) + '0'
     C                                           + %SUBST(F1:2:1)
     C*--------------------------------------------------------
     C                   OTHER
     C                   ITER
     C*--------------------------------------------------------
     C                   ENDSL
     C*
     C                   EVAL      DUN030      = F2
     C                   EVAL      EXWAOKPRGR  = DUC003
     C                   EVAL      EXWAOKJAHR  = 2011
     C                   EVAL      EXWAOKMGPZ  = F6 * 100
     C                   EVAL      EXWAOKPRPZ  = F7 * 100
     C                   EXSR      UWAOK
     C*
     C                   EVAL      EXWAOKJAHR  = 2012
     C                   EVAL      EXWAOKMGPZ  = F8 * 100
     C                   EVAL      EXWAOKPRPZ  = F9 * 100
     C                   EXSR      UWAOK
     C*
     C                   EVAL      EXWAOKJAHR  = 2013
     C                   EVAL      EXWAOKMGPZ  = F10 * 100
     C                   EVAL      EXWAOKPRPZ  = F11 * 100
     C                   EXSR      UWAOK
     C*
     C                   EVAL      EXWAOKJAHR  = 2014
     C                   EVAL      EXWAOKMGPZ  = F12 * 100
     C                   EVAL      EXWAOKPRPZ  = F13 * 100
     C                   EXSR      UWAOK
     C*-------------------------------------------------------------------------
     C                   MOVE      *OFF          *IN
     C                   ENDDO
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  UPDATE DATEI WAOK                                                 ***
     C**************************************************************************
     C     UWAOK         BEGSR
     C*
     C*-------------------------------------------------------------------------
     C                   MOVEL(P)  EXWAOKKSTC    KYWAOKKSTC
     C                   MOVEL(P)  EXWAOKPRGR    KYWAOKPRGR
     C                   Z-ADD     EXWAOKJAHR    KYWAOKJAHR
     C                   MOVEA     '01CU    '    CHI                            LESEN FÜR
     C                   EXSR      CHWAOK                                       UPDATE
     C*-------------------------------------------------------------------------
     C                   Z-ADD     EXWAOKMGPZ    WAOKMGPZ
     C                   Z-ADD     EXWAOKPRPZ    WAOKPRPZ
     C                   MOVEL(P)  '1'           WAOKPLKZ
     C*--------------------------------------------------------
     C                   MOVEL(P)  DAJNAM        WAOKJNAM
     C                   MOVEL(P)  DAPROG        WAOKPROG
     C                   MOVEL(P)  WKCHPL        WAOKBIBL
     C                   MOVEL(P)  DAUSER        WAOKUSER
     C*--------------------------------------------------------
     C                   TIME                    DUN120
     C                   MOVE      DUN120        DUN060
     C     *JOBRUN       MOVE      DUN060        WKTDAT
     C                   MOVEL     DUN120        WAOKJZEI
     C                   MOVE      WKTDAT        WAOKJDAT
     C*-------------------------------------------------------------------------
     C                   SELECT
     C*--------------------------------------------------------
     C     CHI(6)        WHENEQ    *ON
     C                   MOVEA     '01W     '    CHI
     C                   EXSR      CHWAOK
     C*--------------------------------------------------------
     C     CHI(6)        WHENEQ    *OFF
     C                   MOVEA     '01U     '    CHI
     C                   EXSR      CHWAOK
     C*--------------------------------------------------------
     C                   ENDSL
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  DEFINITION DER WORKFELDER...                                      ***
     C**************************************************************************
     C     VLIKE         BEGSR
     C*
     C*-------------------------------------------------------------------------
     C***  ...ANHAND WKC001                                                  ***
     C*-------------------------------------------------------------------------
     C     *LIKE         DEFINE    WKC001        ##CHI           + 7
     C     *LIKE         DEFINE    WKC001        ##RTCD
     C     *LIKE         DEFINE    WKC001        ##PGST
     C*--------------------------------------------------------
     C     *LIKE         DEFINE    WKC001        WKFENR          + 3
     C     *LIKE         DEFINE    WKC001        WKI000
     C     *LIKE         DEFINE    WKC001        WKTRPA
     C*-------------------------------------------------------------------------
     C***  ...ANHAND WKN...                                                  ***
     C*-------------------------------------------------------------------------
     C     *LIKE         DEFINE    WKN010        I0              + 2
     C     *LIKE         DEFINE    WKN010        I1              + 2
     C     *LIKE         DEFINE    WKN010        I2              + 2
     C*-------------------------------------------------------------------------
     C***  ...ANHAND DATEI-/DATENSTRUKTURFELDERN                             ***
     C*-------------------------------------------------------------------------
     C     *LIKE         DEFINE    RTWAOKPROG    WKPROG
     C     *LIKE         DEFINE    RTWAOKDANA    WKDANA
     C     *LIKE         DEFINE    RTWAOKFFLD    WKFFLD
     C*-------------------------------------------------------------------------
     C*
     C                   ENDSR
     C**************************************************************************
     C***  COPY-MODULE                                                       ***
     C**************************************************************************
     C/COPY QCPYSRC,CHWAOK
     C/COPY QCPYSRC,CHTRPA
     O**************************************************************************
     O***  ENDE DES PROGRAMMS                                                ***
     O**************************************************************************
