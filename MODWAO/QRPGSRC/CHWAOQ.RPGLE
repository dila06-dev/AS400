     C                   EXSR      ULOCK
     C                   ELSE
     C                   MOVE      *BLANK        WAOQLOCK
     C                   ENDIF
     C*
     C                   WRITE     WAOQ01A                              98
     C*
     C     *IN98         IFEQ      *OFF
     C                   EXSR      LZUGR
     C                   MOVE      'J'           WKCHRT
     C                   ENDIF
     C*--------------------------------------------------------
     C     WKCHOP        WHENEQ    '-'                                          SETGT/READP
     C     KYWAOQ01      SETGT     WAOQ01                             9798
     C                   MOVEA     *OFF          *IN(97)
     C                   READP     WAOQ01                               9899
     C*
     C     *IN98         IFEQ      *OFF
     C     *IN99         ANDEQ     *OFF
     C                   EXSR      SZUGR
