PGM

/* WOCHENMELDUNGEN AN KD.009626 PER CSV MAIL               */
             ADDLIBLE   LIB(TVRELWAECO)
             RUNQRY     QRY(TVRELWAECO/#ATLANT_01)
             RUNQRY     QRY(TVRELWAECO/#ATLANT_02)
             RUNQRY     QRY(TVRELWAECO/#ATLANT_03)
             RMVLIBLE   LIB(TVRELWAECO)


/* WOCHENMELDUNGEN AN ELEKTOSHOP24.DE PER CSV MAIL          */
             ADDLIBLE   LIB(TVRELWAECO)
             RUNQRY     QRY(TVRELWAECO/##ELEKTRO1)
             RUNQRY     QRY(TVRELWAECO/##ELEKTRO2)
             RUNQRY     QRY(TVRELWAECO/##ELEKTRO3)
             CVTDBF     OBJ('BARENKAMP/ELEKTRO24.CSV') +
                          DBFILE(TVRELWAECO/ELEKTRO) DBMBR(*FIRST) +
                          DBOUTFMT(*CSV) DBFLDDSC(*NO)
             RUNQRY     QRY(TVRELWAECO/##ELEKTRO4)

             RMVLIBLE   LIB(TVRELWAECO)

/* WOCHENMELDUNGEN AN GALAXUS   PER CSV MAIL               */
             ADDLIBLE   LIB(TVRELWAECO)
             RUNQRY     QRY(TVRELWAECO/#GALAXUS1)
             RUNQRY     QRY(TVRELWAECO/#GALAXUS2)
             RUNQRY     QRY(TVRELWAECO/#GALAXUS3)
             RMVLIBLE   LIB(TVRELWAECO)











ENDPGM
