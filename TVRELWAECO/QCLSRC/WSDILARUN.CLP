DCL VAR(&STATUS) TYPE(*CHAR) LEN(10)

WRKACTJOB SBS(QHTTPSVR) OUTPUT(*PRINT)
RCVMSG MSGTYPE(*LAST) RMV(*YES)

DSPLOG QSYSOPR PERIOD((*AVAIL *AVAIL)) OUTPUT(*PRINT)
RCVMSG MSGTYPE(*LAST) RMV(*YES)

CHKHTTPSTS:
    RTVTCPSVR SERVER(*HTTP) HTTPSVR(WSDILA) STATUS(&STATUS)

    IF COND(&STATUS *NE 'ACTIVE') THEN(DO)
        STRTCPSVR SERVER(*HTTP) HTTPSVR(WSDILA)
    ENDDO







