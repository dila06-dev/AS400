     A            NAME          30A         COLHDG('NAME')
     A            EMAIL        120A         COLHDG('EMAIL')
     A            COMPANY      120A         COLHDG('COMPANY')
     A            SHORTCUT      03A         COLHDG('SHORTCUT')
     A            GROUPDOM      10A         COLHDG('GROUPDOM')
     A            DAYOFW1       04A         COLHDG('DAYOFW1')
