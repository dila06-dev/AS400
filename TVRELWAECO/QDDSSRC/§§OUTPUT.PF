     A            DAYOFW3       04A         COLHDG('DAYOFW3')
     A            DAYOFW4       04A         COLHDG('DAYOFW4')
     A            DAYOFW5       04A         COLHDG('DAYOFW5')
     A            DAYOFW6       04A         COLHDG('DAYOFW6')
     A            DAYOFW7       04A         COLHDG('DAYOFW7')
     A            DAYUNTIL      02A         COLHDG('DAYUNTIL')
     A            FREE         120A         COLHDG('FREE')
     A            DATEINPUT       L         TEXT('Date of transmissing')
     A            TSTAMP          Z         TEXT('TIMESTAMP')
     A            AKTIV          1A         TEXT('AKTIV')
