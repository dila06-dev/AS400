     A*CPYFRMIMPF FROMFILE(TVRELWAECO/FROM_EXCEX)
     A*              TOFILE(TVRELWAECO/SUN_ITEMS)
     A*              MBROPT(*REPLACE) FLDDLM(';')
     A*                       RPLNULLVAL(*FLDDFT)
     A*
     A*CPYFRMIMPF FROMFILE(TVRELWAECO/FROM_EXCEX)
     A*           TOFILE(TVRELWAECO/SUN_ITEMS)
     A*           MBROPT(*REPLACE) FLDDLM(';')
     A*           DECPNT(*COMMA) RPLNULLVAL(*FLDDFT)
     A*
     A*
     A          R SUN_ITEMSR                TEXT('SKU#')
     A*****************************************************************
     A            FIRMA         02A         COLHDG('FIRMA')
