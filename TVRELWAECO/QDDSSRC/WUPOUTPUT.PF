     A            WUPWE         10A         COLHDG('WUPWE     ')
     A            AELFNR        10A         COLHDG('AELFNR    ')
     A            TCT            1A         COLHDG('TCT       ')
     A            TSTAMP          Z         TEXT('TIMESTAMP')
     A            VBKZ           1A         COLHDG('VBKZ     ')
     A            STATUS         1S 0       COLHDG('STATUS    ')
     A            RT             1S 0       COLHDG('RT        ')
     A            LNLDNR         3A         COLHDG('LANDNR    ')
     A            LNLDGR         4A         COLHDG('LANDGRUPPE')
