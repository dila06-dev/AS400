     A* INSERT INTO KPIF
     A* SELECT  CHAR(' ', 1)         KPLOCK,  CHAR('GANG#', 10)   KPJNAM,
     A* ZONED(('20')
     A* CONCAT  SUBSTR(CHAR(CURRENT DATE +0 DAY), 7, 2)  CONCAT
     A* SUBSTR(CHAR(CURRENT DATE +0 DAY), 4, 2)  CONCAT
     A* SUBSTR(CHAR(CURRENT DATE +0 DAY), 1, 2), 8, 0)   KPJDAT,
     A* ZONED(SUBSTR(CHAR(CURRENT TIME), 1, 2)  CONCAT
     A* SUBSTR(CHAR(CURRENT TIME), 7, 2), 6, 0)   KPJZEI,
     A*         CHAR('GANG#', 10)         KPUSER,
     A*         CHAR('KDPIF_SQL', 10)          KPPROG,
     A*         CHAR('TVRELWAECO', 10)    KPBIBL,
     A*         CHAR('01', 02)            KPFIRM,
     A*         INP1                      KPKDNR,
     A*         CHAR('  ', 03)            KPVSNR,
     A*         ITEM  KPTENR , ZONED(0       , 8, 0)   KPGADA,
     A*         CHAR(INP2   CONCAT '               ', 30) KPIDEN,
     A*         CHAR(' ', 30) KPIBZ1,
     A*         CHAR(' ', 30) KPIBZ2,   CHAR(' ', 25) KPZINR,
     A*         ZONED(0, 11, 3) KPEZPR, CHAR('EUR', 3) KPWACD,
     A*         ZONED(0, 8, 0) KPLFDA,  CHAR('N', 1) KPDRIB,
     A*         CHAR(' ', 3) KPBSPL,    CHAR(' ', 1) KPMPVK,
     A*         CHAR(' ', 1) KPMEBE,    CHAR(' ', 17) KPAEND,
     A*         CHAR(' ', 15) KPBKNR,   CHAR(' ', 17) KPBKAE,
     A*         CHAR(' ', 15) KPKPTE,   CHAR(' ', 1) KPPRKZ,
     A*         ZONED(0, 11, 2) KPABMP, ZONED(0, 11, 2) KPABMG,
     A*         CHAR(' ', 1) KPWKPZ,    CHAR('N', 1) KPDSKZ,
     A*         CHAR(' ', 30) KPRFNR,   CHAR(' ', 8) KPCHAF,
     A*         CHAR(' ', 10) KPLFNR,   ZONED( 0, 3, 0) KPLFKZ,
     A*         CHAR(' ', 1) KPRLFA,    CHAR('N', 1) KPEGMD,
     A*         CHAR('01', 2) KPSTAT,    CHAR(' ', 1) KPVWAR,
     A*         CHAR('0', 1) KPEASC,    CHAR(' ', 202) KPFREX
     A* FROM         ITEMS000_O          A
     A* WHERE A.ITEM   <> ' ' AND
     A*                                 A.INP1   NOT IN
     A* ( SELECT KPTENR FROM KPIF01  WHERE  ITEM   =   KPTENR )
     A* 3246 ZEILEN IN KPIF IN TVPF EINGEFÜGT.
     A*         DATUM IMMER TT.MM.JJJJ
     A*         ZEIT  IMMER HH:MM
     A          R ITEMS000_O                TEXT('____')
     A*****************************************************************
     A            ENTITYID      10A         COLHDG('ENTITYID  ')
     A            SKU           15A         COLHDG('SKU       ')
     A            SKUDES        50A         COLHDG('SKUDES    ')
     A            SKUDESFAC     20A         COLHDG('INPUT 2   ')
     A            P_ART         05A         COLHDG('P_ART     ')
     A            P_GRUPPE      05A         COLHDG('P_GRUPPE  ')
     A            P_FINANZ      05A         COLHDG('P_FINANZ  ')
     A            P_AREA_D      10A         COLHDG('P_AREA_D  ')
     A            P_SKUMODEL    10A         COLHDG('P_SKUMODEL')
     A            P_FACTORY     30A         COLHDG('P_FACTORY ')
     A            P_COUNTRYC    04A         COLHDG('P_COUNTRYC')
     A            ITEMMASTER    30A         COLHDG('ITEMMASTER')
     A            STATUS_SKU    30A         COLHDG('STATUS_SKU')
     A            BRAND         30A         COLHDG('BRAND     ')
     A*****************************************************************
     A            H1            10A         TEXT('status')
     A            H2              L         TEXT('Date of transmissing')
     A            H3              Z         TEXT('TIMESTAMP')
     A            H4           256A         TEXT('statusII')
     A            H5              L         TEXT('Date of UPLOAD      ')
     A            H6              Z         TEXT('TIMESTAMP OF UPLOAD')
     A
