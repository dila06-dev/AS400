     C*                  enddo
     C*                  close     man
b
     C**************************************************************************
     C*über preselect lesen der Interface_daten
     C*-------------------------------------------------------------------------

     C*write
     c                   exsr      sr6000

     C                   EXSR      RETURN

     C**************************************************************************
     C*time stamp
     C*-------------------------------------------------------------------------
     C*
     C     sr6000        BEGSR
     C*
     c/exec sql
     c+ whenever not found CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLWARNING CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLERROR  CONTINUE
     c/end-exec

     C*
     c/exec sql
     c+ insert into GRPP
     c+ select  char(' ', 1) GRPPLOCK,  char('GANG#', 10)   GRPPJNAM,
     c+ zoned(('20')
     c+ concat  substr(char(current date +0 day), 7, 2)  concat
     c+ substr(char(current date +0 day), 4, 2)  concat
     c+ substr(char(current date +0 day), 1, 2), 8, 0) GRPPJDAT,
     c+ zoned(substr(char(current time), 1, 2)  concat
     c+ substr(char(current time), 4, 2)  concat
     c+ substr(char(current time), 7, 2), 6, 0)   GRPPJZEI,
     c+         char('GANG#', 10)         GRPPUSER,
     c+         char('KDPIFR   ', 10)     GRPPPROG,
     c+         char('TVRELWAECO', 10)    GRPPBIBL,
     c+         char('55', 02)            GRPPFIRM,
     c+         substr(SRCDTA, 1, 10)     GRPPTENR,
     c+         char('  ', 15)            GRPPEZNR,
     c+         substr(SRCDTA, 12, 04)    GRPPGPMG,
     c+         zoned(1, 13, 6)           GRPPMGAT,
     c+         char('K', 1)              GRPPMEIN,
     c+         char('N', 1)              GRPPPRZ1,
     c+         char(' ', 20)             GRPPFRIN,
     c+         char(' ', 100)            GRPPFREX
     c+ from         CSV_ITEMS           a
     c+ where substr(SRCDTA, 1, 10) not in
     c+      ( select GRPPTENR from grpp where GRPPFIRM ='55'  )
     c/end-exec


     C     ##6000        ENDSR

     C**************************************************************************
     C*time stamp
     C*-------------------------------------------------------------------------
     C*
     c/exec sql
     c+ whenever not found goto ##9999
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLWARNING CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLERROR  CONTINUE
     c/end-exec
     C     sr9999        BEGSR
     C*

     c/exec sql
     c+ select current timestamp, current date, current time
     c+ into   :tstampi, :datum, :zeit
     c+ from   gang/systempf
     c/end-exec

     C     ##9999        ENDSR

     C*-------------------------------------------------------------------------

     C     *inzsr        BEGSR
      *

     C                   TIME                    Date
     c                   extrct    date:*Y       jahr
     c                   extrct    date:*M       monat
     C                   extrct    date:*D       tag

     c                   CLEAR                   ATR
     c                   CALL      '#MODATR'                            97
     c                   PARM                    ATR
     C                   ENDSR

