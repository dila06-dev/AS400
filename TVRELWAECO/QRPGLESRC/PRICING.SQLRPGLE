b
     C*    *ENTRY        PLIST
     C*                  PARM                    ic               06
b
     C**************************************************************************
     C*über preselect lesen der Interface_daten
     C*-------------------------------------------------------------------------

     C*Absatz/Umsatzdaten
     c                   exsr      sr2000
     c                   exsr      sr1000

     C                   EXSR      RETURN

     C**************************************************************************
     C*Absatzzahlen
     C*-------------------------------------------------------------------------
     C*
     C     sr1000        BEGSR
     C*
     c/exec sql
     c*+ whenever not found goto ##1000
     c+ whenever not found CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLWARNING CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLERROR  CONTINUE
     c/end-exec

     C*UPDATE_ID ='X' ==> special filter ohne sku wechsel
     C*                   but replacement is like sku  ==>REPLACEM =sku
     C*diese Artikel müssen angelegt werden ursache sku wechsel
     c/exec sql
     c+ insert into tvrelwaeco/ITEMWRITE
     c+ SELECT * FROM itemserv#
     c+ WHERE UPDATE_ID ='X' and REPLACEM =sku
     c/end-exec

     C*... und aus originaldatei löschen
     c/exec sql
     c+ delete FROM itemserv# WHERE ITEM in
     c+ ( select item from itemwrite)
     c/end-exec



     C*UPDATE_ID ='X' ==> special filter, where we didn't change
     C*                   any sku's
     C*                   normal new item
     C*diese Artikel müssen angelegt werden normal new items
     c/exec sql
     c+ insert into tvrelwaeco/ITEMupdate
     c+ SELECT * FROM itemserv# WHERE
     c+ UPDATE_ID ='X' and ITEM = sku and REPLACEM =' '
     c/end-exec

     C*... und aus originaldatei löschen
     c/exec sql
     c+ delete FROM itemserv# WHERE ITEM in
     c+ ( select item from ITEMupdate)
     c/end-exec


     C*UPDATE_ID ='X' ==> special filter, where we didn't change
     C*                   any sku's
     C*                   normal new item
     C*diese Artikel müssen angelegt werden
     c/exec sql
     c+ insert into tvrelwaeco/ITEMwrite
     c+ SELECT * FROM itemserv# WHERE
     c+ UPDATE_ID ='X' and ITEM = sku and REPLACEM =' '
     c/end-exec

     C*... und aus originaldatei löschen
     c/exec sql
     c+ delete FROM itemserv# WHERE ITEM in
     c+ ( select item from itemwrite)
     c/end-exec


     c*
     C     ##1000        ENDSR
     c*
     c*
     C**************************************************************************
     C*time stamp COMWEBBRO
     C*-------------------------------------------------------------------------

     C     sr2000        BEGSR
     C*
      /free
       MONITOR;
       Wrk.var1 =
           'CLRPFM' + ' ' +
           'TVRELWAECO/ITEMSERV#';
         cmd = %TrimR(Wrk.Var1);

         Laenge = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
       on-error;
       endmon;
      /End-Free

      /free
       MONITOR;
       Wrk.var1 =
           'CPYF FROMFILE(TVRELWAECO/ITEMSERV)' + ' ' +
           'TOFILE(TVRELWAECO/ITEMSERV#)      ' + ' ' +
           'MBROPT(*REPLACE) CRTFILE(*NO)';
         cmd = %TrimR(Wrk.Var1);

         Laenge = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
       on-error;
       endmon;
      /End-Free

     C*
      /free
       MONITOR;
       Wrk.var1 =
           'CLRPFM' + ' ' +
           'TVRELWAECO/ITEMUPDATE';
         cmd = %TrimR(Wrk.Var1);

         Laenge = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
       on-error;
       endmon;
      /End-Free

      /free
       MONITOR;
       Wrk.var1 =
           'CLRPFM' + ' ' +
           'TVRELWAECO/ITEMWRITE';
         cmd = %TrimR(Wrk.Var1);

         Laenge = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
       on-error;
       endmon;
      /End-Free


     C     ##2000        ENDSR

     c*
     C**************************************************************************
     C*time stamp
     C*-------------------------------------------------------------------------

     C     sr9999        BEGSR
     C*
     c/exec sql
     c+ whenever not found goto ##9999
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLWARNING CONTINUE
     c/end-exec
     c/exec sql
     c+ WHENEVER SQLERROR  CONTINUE
     c/end-exec
     C*

     c/exec sql
     c+ select current timestamp, current date, current time
     c+ into   :tstampi, :datum, :zeit
     c+ from   gang/systempf
     c/end-exec

     C     ##9999        ENDSR

