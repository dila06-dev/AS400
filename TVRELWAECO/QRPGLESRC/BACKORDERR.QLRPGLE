       //Korrekturen Roloff Liefertermin bis current date
        exec sql
           update tvrelwaeco/backorders b set backcurv  =
           (select dec(sum(wert), 12, 2 ) fROM RPMEXPECM0 a WHERE a.YEAR#
           =year(current date - 0 day) and
           (a.week# =week(current date - 0 day)-1              )
       //  (a.week# =week(current date - 0 day)-1 or a.week# =1)
           and a.akfirm ='01' and a.APAFST ='17' and a.item=b.item and
           date(substr(a.PLANKUNDE, 1, 4) concat '-' concat
                substr(a.PLANKUNDE, 5, 2) concat '-' concat
                substr(a.PLANKUNDE, 7, 2) ) < current date +0 day
                and b.tstamp > current timestamp -1 hour group by a.item)
           where exists
           (select dec(sum(wert), 12, 2 ) fROM RPMEXPECM0 a WHERE a.YEAR#
           =year(current date - 0 day) and
           (a.week# =week(current date - 0 day)-1              )
       //  (a.week# =week(current date - 0 day)-1 or a.week# =1)
           and a.akfirm ='01' and a.APAFST ='17' and a.item=b.item and
           date(substr(a.PLANKUNDE, 1, 4) concat '-' concat
                substr(a.PLANKUNDE, 5, 2) concat '-' concat
                substr(a.PLANKUNDE, 7, 2) ) < current date +0 day
                and b.tstamp > current timestamp -1 hour group by a.item);

       //Korrekturen Roloff Liefertermin bis current date
        exec sql
           update tvrelwaeco/backorders b set backcurp  =
           (select dec(sum(apglmg), 12, 2 ) fROM RPMEXPECM0 a WHERE a.YEAR#
           =year(current date - 0 day) and
           (a.week# =week(current date - 0 day)-1              )
       //  (a.week# =week(current date - 0 day)-1 or a.week# =1)
           and a.akfirm ='01' and a.APAFST ='17' and a.item=b.item and
           date(substr(a.PLANKUNDE, 1, 4) concat '-' concat
                substr(a.PLANKUNDE, 5, 2) concat '-' concat
                substr(a.PLANKUNDE, 7, 2) ) < current date +0 day
                and b.tstamp > current timestamp -1 hour group by a.item)
           where exists
           (select dec(sum(apglmg), 12, 2 ) fROM RPMEXPECM0 a WHERE a.YEAR#
           =year(current date - 0 day) and
           (a.week# =week(current date - 0 day)-1              )
       //  (a.week# =week(current date - 0 day)-1 or a.week# =1)
           and a.akfirm ='01' and a.APAFST ='17' and a.item=b.item and
           date(substr(a.PLANKUNDE, 1, 4) concat '-' concat
                substr(a.PLANKUNDE, 5, 2) concat '-' concat
                substr(a.PLANKUNDE, 7, 2) ) < current date +0 day
                and b.tstamp > current timestamp -1 hour group by a.item);

        exec sql
           inserT into qtemp/back01b
           SELECT item,                     ITEMDESC          itemname,
                 CUSTOMER# ,CUSTOMER ,
           dec(sum(wert), 12, 2 ) value,
           dec(sum(APGLMG), 12, 2 ) pcs
           from RPMEXPECM0
           WHERE YEAR# =year(current date - 0 day) and week#
           =week(current date - 0 day) and akfirm ='01' and APAFST ='17' and
           date(substr(PLANKUNDE, 1, 4) concat '-' concat
                substr(PLANKUNDE, 5, 2) concat '-' concat
                substr(PLANKUNDE, 7, 2) ) < current date +0 day
           group BY item,ITEMDESC, CUSTOMER#,CUSTOMER;

        exec sql
           insert into tvrelwaeco/backorders
           SELECT char('2', 1) fkt, ITEM, ITEMNAME,
             CUSTOMER# ,CUSTOMER, ' ', value backcurv,
             pcs  backcurp,   decimal(0, 12, 2) maxstock,
                                     char(' ', 40 ) rootcause,
           char(' ', 10 ) lieferant,char(' ', 40 ) supname,
           decimal(0, 12, 0) forecast,  decimal(0, 12, 2) onstock,
           decimal(0, 10, 0) arrivalw1, decimal(0, 10, 0) arrivalw2,
           decimal(0, 10, 0) arrivalw3, decimal(0, 10, 0) arrivalw4,
           decimal(0, 10, 0) arrivalw5, decimal(0, 10, 0) arrivalw6,
           char(' ', 5) disponent, char(' ', 5), 0,00 , 0 , char(' ', 60) info,
           current timestamp tstamp , 0
           from qtemp/back01b;

       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back01b)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back01b)            ';
       on-error;
          status='Error by clrpfm object (qtemp/back01b)           ';
       endmon;

        exec sql
           inserT into qtemp/back01b
           SELECT item,                     ITEMDESC          itemname,
                 CUSTOMER# ,CUSTOMER ,
           dec(sum(wert), 12, 2 ) value,
           dec(sum(APGLMG), 12, 2 ) pcs
           from RPMEXPECM0
           WHERE YEAR# =year(current date - 0 day) and week#
           =week(current date - 0 day) and akfirm ='01' and APAFST ='17' and
           date(substr(PLANKUNDE, 1, 4) concat '-' concat
                substr(PLANKUNDE, 5, 2) concat '-' concat
                substr(PLANKUNDE, 7, 2) ) > current date -1 day
           group BY item, ITEMDESC,  CUSTOMER#,CUSTOMER;

        exec sql
           insert into tvrelwaeco/backorders
           SELECT char('3', 1) fkt, ITEM, ITEMNAME,
             CUSTOMER# ,CUSTOMER, ' ', value backcurv,
             pcs  backcurp,   decimal(0, 12, 2) maxstock,
                                     char(' ', 40 ) rootcause,
           char(' ', 10 ) lieferant,char(' ', 40 ) supname,
           decimal(0, 12, 0) forecast,  decimal(0, 12, 2) onstock,
           decimal(0, 10, 0) arrivalw1, decimal(0, 10, 0) arrivalw2,
           decimal(0, 10, 0) arrivalw3, decimal(0, 10, 0) arrivalw4,
           decimal(0, 10, 0) arrivalw5, decimal(0, 10, 0) arrivalw6,
           char(' ', 5) disponent, char(' ', 5), 0,00 , 0 , char(' ', 60) info,
           current timestamp tstamp , 0
           from qtemp/back01b;

        exec sql
       //  update backorders set CUSTOMER = '==>' concat
           update backorders set CUSTOMER =
           (select kdnam1 from kund01 where kdfirm='01' and
            CUSTOMER#               =kdkdnr  and (fkt='2' or fkt='3'))
           where exists
           (select kdnam1 from kund01 where kdfirm='01' and
            CUSTOMER#               =kdkdnr  and (fkt='2' or fkt='3'));

       //*all
       //name/beschreibung
        exec sql
           update TVRELWAECO/backorders set ITEMNAME  =
           (select TETBZ1  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour)
           where exists
           (select TETBZ1  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour);

       //dispo/beschreibung
        exec sql
           update TVRELWAECO/backorders set disponent =
           (select TEDIEK  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour)
           where exists
           (select TEDIEK  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour);

       //eink/beschreibung
        exec sql
           update TVRELWAECO/backorders set eink      =
           (select TESAEK  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour)
           where exists
           (select TESAEK  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour);

       //update Gleichheit Division
       exec sql
          update TVRELWAECO/backorders set division  =
          (select KDEWKSST from kdew01 where kdewfirm='01'
           and kdewkdnr=CUSTOMER#)
          where exists
          (select KDEWKSST from kdew01 where kdewfirm='01'
           and kdewkdnr=CUSTOMER#);

       //update Gleichheit Division
       exec sql
          update TVRELWAECO/backorders set division  = case
          When division = '1001      ' then 'RVOEM     '
          When division = '1002      ' then 'RVAM      '
          When division = '1003      ' then 'RETL      '
          When division = '1004      ' then 'LODG      '
          When division = '1005      ' then 'CPVOEM    '
          When division = '1006      ' then 'CPVAM     '
          When division = '1007      ' then 'MAOEM     '
          When division = '1008      ' then 'MAAM      '
          When division = '1009      ' then 'MEDI      '
          When division = '1015      ' then 'GROUP     '
          When division = '1020      ' then 'OTHER 1020'
          When division = '6050      ' then 'OTHER 6050'
          else 'undefined'
          end;

       //Sicherheitsbestand
        exec sql
           update TVRELWAECO/backorders set SAFETY    =
           (select TEsibe  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour)
           where exists
           (select TESibe  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour);

       //Vorlaufzeit
        exec sql
           update TVRELWAECO/backorders set lead      =
           (select TEVOZ1  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour)
           where exists
           (select TEVOZ1  from teil01   where tefirm='01' and tetenr=item
            and tstamp > current timestamp -1 hour);

       //Mindestbestand problematisch
        exec sql
           insert into tvrelwaeco/backorders
           SELECT char('4', 1) fkt, tetenr, TETBZ1,
             ' ',       ' ',      ' ',  0            ,
             0    backcurp,   decimal(0, 12, 2) maxstock,
                                     char(' ', 40 ) rootcause,
           char(' ', 10 ) lieferant,char(' ', 40 ) supname,
           decimal(0, 12, 0) forecast,  decimal(0, 12, 2) onstock,
           decimal(0, 10, 0) arrivalw1, decimal(0, 10, 0) arrivalw2,
           decimal(0, 10, 0) arrivalw3, decimal(0, 10, 0) arrivalw4,
           decimal(0, 10, 0) arrivalw5, decimal(0, 10, 0) arrivalw6,
           TEDIEK, TESAEK ,TESibe,TEVOZ1 , char(' ', 60) info,
           current timestamp tstamp , 0
           from teil01 b where tefirm = '01' and TETEST<>'90' and TESibe <
           (select bestand from abestand a where
                 a.tetenr=b.tetenr and lager='001') and
           b.tetenr not in (select item from backorders);

       //update aktueller Bestand
        exec sql
           update TVRELWAECO/backorders set onstock   =
           (select bestand from abestand where tetenr=item   and lager='001'
            and tstamp > current timestamp -1 hour)
           where exists
           (select bestand from abestand where tetenr=item   and lager='001'
            and tstamp > current timestamp -1 hour);

        exec sql
           update           backorders set info =
           'other orders available for this item' where fkt ='4 '
           and item in ( select aptenr from afpo01 where apfirm='01'
           and APAFST  < '80' and apafst <> '17');
       endif;

       //update
       exec sql
        whenever not found continue;
       exec sql
        WHENEVER SQLWARNING CONTINUE;
       exec sql
        WHENEVER SQLERROR  CONTINUE;

       endsr;

       //-----------------------------------------------------------------------
       //report
       //-----------------------------------------------------------------------

       begsr SR_output;


       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(tvrelwaeco/backordero)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(tvrelwaeco/backordero)    ';
       on-error;
          status='Error by clrpfm object (tvrelwaeco/backordero)   ';
       endmon;



       //exec sql
       //  insert into tvrelwaeco/backordero
       //  select * from  backorders
       //  where tstamp > current timestamp -1 hour
       //               and FKT =' ';

       exec sql
         insert into tvrelwaeco/backordero
         SELECT FKT, ITEM, ITEMNAME, BACKCURV, BACKCURP, ROOTCAUSE,
         LIEFERANT, SUPNAME, FORECAST, ONSTOCK, ARRIVALW1, ARRIVALW2,
         ARRIVALW3, ARRIVALW4, ARRIVALW5, ARRIVALW6, DISPONENT, INFO,
         TSTAMP, RRN# FROM backorders
         WHERE tstamp > current timestamp -02 hour;
       //                                          and FKT =' ';

         eval p_infil   =  'BACKORDERO'        +
                        %char(%dec(%char(%date():*iso0):8:0)) +
                        %char(%dec(%char(%time():*iso0):8:0));
         eval p_outfil =  'BACKORDERO';

         eval p_msgf    =  *blank;
         eval p_print   =  *blank;
         eval p_lib     =  'TVRELWAECO';

         clear     Wrk.var1;
         clear     status;

       MONITOR;
       Wrk.var1 =
           'RMVLNK OBJLNK(''/LAGER/BACKORDERO*'')';
         cmd = %TrimR(Wrk.Var1);
         l      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='rmvlnk successful removed BACKORDERO*            ';
          exsr      SR_log;
       on-error;
          status='Error by rmvlnk object BACKORDERO*               ';
          exsr      SR_log;
       endmon;

       eval p_outfil  =  'BACKORDERO';

       MONITOR;
       Wrk.var1 =
           'CVTDBF OBJ(''/LAGER/'+ p_infil +''  +
                      '.csv'') ' +
           'DBFILE(TVRELWAECO/'+ p_outfil +') DBOUTFMT(*CSV) '  +
           'DBFLDDSC(*YES)';
         cmd = %TrimR(Wrk.Var1);
         l      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CVTDBF successful done                           ';
          exsr      SR_log;
       on-error;
          status='Error by CVTDBF object BACKORDERO                ';
          exsr      SR_log;
       endmon;
       eval p_outfil  =  'BACKORDERO';

       MONITOR;
       Wrk.var1 =
           'CHGAUT OBJ(''/Lager/'+ p_infil +''  +
                      '.csv'') ' +
           'USER(*PUBLIC) DTAAUT(*RWX)                   ' +
           'OBJAUT(*OBJMGT *OBJEXIST *OBJALTER *OBJREF)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='chgaut successful FILE(TVRELWAECO/BACKORDERO)    ';
       on-error;
          status='Error by chgaut object (TVRELWAECO/BACKORDERO)   ';
       endmon;

       //...
       //'TOFILE(*LIBL/QPQXPRTF) DEV(PRT55) '  +
       MONITOR;
       Wrk.var1 =
           'OVRPRTF FILE(QPQXPRTF) '  +
           'TOFILE(*LIBL/QPQXPRTF) DEV(PRT10) '  +
           'FORMTYPE(''BACKORDERO'') OVRSCOPE(*JOB)';
         cmd = %TrimR(Wrk.Var1);
         l      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='OVRPRTF successful done                          ';
          exsr      SR_log;
       on-error;
          status='Error by OVRPRTF object ' +
                         p_outfil +'csv';
          exsr      SR_log;
       endmon;
       eval p_outfil  =  'BACKORDERO';

       //-----------------------------------------------------------------------
       //'CALL  PGM(DUMMY512) PARM('' '' ''#DC0001'' '' '' ''PRT55'' ' +
       //''' '' '' '' '' '')';
       //-----------------------------------------------------------------------
       MONITOR;
       Wrk.var1 =
           'CALL  PGM(DUMMY512) PARM('' '' ''#DC0001'' '' '' ''PRT10'' ' +
           ''' '' '' '' '' '')';
         cmd = %TrimR(Wrk.Var1);
         l      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='OVRPRTF successful done                          ';
          exsr      SR_log;
       on-error;
          status='Error by DUMMY512                        ';
          exsr      SR_log;
       endmon;

       endsr;

       //-----------------------------------------------------------------------
       //log report
       //-----------------------------------------------------------------------

       begsr sr_log;

         clear p_md;
       //  %Subarr(p_md:01)  = 'AT_item   ';
       //  %Subarr(p_md:11:10)  = §§§JOB;
       //  %Subarr(p_md:22:10)  = §§§USR;
       //  %Subarr(p_md:33:132) = status;
         eval p_md      =  §§§PGM         +
                           §§§JOB         +
                           §§§USR         +
                           status;

         eval p_msg     =  '#DC0002';
         eval p_msgf    =  *blank;
         eval p_print   =  *blank;
         eval p_outfil  =  'JOB_RUN   ';
         eval p_lib     =  'TVRELWAECO';
         eval p_repadd  =  '*ADD';

         callP DUMMY512(p_md:     p_msg:    p_msgf:     p_print:
                        p_outfil: p_lib:    p_repadd);
         clear status;

       //callP     QMHSNDPM('CPF9897': 'QCPFMSG   *LIBL':
       //            Msg: MsgLen: '*ESCAPE':
       //            '*': 3: TheKey: dsEC);

       endsr;


