      // Überschreibungen
      // ______________________________________________________________________
      /eject
      //************************************************************************
      //          -----------------
      //          M A I N - L I N E
      //          -----------------
      //************************************************************************


      /FREE

       §records=*zero;

       eval status ='Start BACKORDERR              ' ;
       exsr      SR_log;


       exsr  srinit;
       exsr  sr_BACKORD;
       exsr  SR_output;
       err_msg   = '0';

       if §records <> *zero;
       endif;

       // ______________________________________________________________________
       if error1 =  '0';
       //liblist
          MONITOR;
             Wrk.var1 =
                 'RMVLIBLE LIB(DOMDATV7)';
             cmd = %TrimR(Wrk.Var1);
             L      = %Len(Cmd);
             QCMDEXC(cmd: %len(cmd));
                error1 ='0';
             on-error;
                status='error  RMVLIBLE LIB(DOMDATV7)                   ';
                exsr      SR_log;
                error1 ='1';
          endmon;
       endif;

       if error2 =  '0';
       //liblist
          MONITOR;
             Wrk.var1 =
                 'RMVLIBLE LIB(DOMCOMV7)';
             cmd = %TrimR(Wrk.Var1);
             L      = %Len(Cmd);
             QCMDEXC(cmd: %len(cmd));
                error2 ='0';
             on-error;
                status='error  RMVLIBLE LIB(DOMCOMV7)                   ';
                exsr      SR_log;
                error2 ='1';
          endmon;
       endif;



       eval status ='Ende  BACKORDERR              ';

       exsr      SR_log;

       *inlr = *on;

      /eject
       //***********************************************************************
       //    ---------------------
       //    S U B R O U T I N E S
       //    ---------------------
       //***********************************************************************


       //-----------------------------------------------------------------------
       //
       //    %dec(Datum:*iso) => JJJJMMTT
       //    %dec(Datum:*eur) => TTMMJJJJ
       //    %dec(Datum:*jul) => JJJJTTT
       //    select current timestamp, current date, current date -365 day,
       //           current time, dec(DAYOFWEEK_iso(current date ), 1, 0),
       //                         dec(week_iso(current date ), 2, 0),
       //                         dec(week(current date ), 2, 0)
       //-----------------------------------------------------------------------

       begsr srinit;

       exec sql
         select  dec (week_iso(current date-07  day ), 2, 0)
                 into            :curweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (week_iso(current date+42  day ), 2, 0)
                 into            :maxweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date-07  day ), 4, 0)
                 into            :curyear
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+42  day ), 4, 0)
                 into            :maxyear
                 from   qsys2/qsqptabl;
        eval     maxdate = maxyear *100 + maxweek;
        eval     curdate = curyear *100 + curweek;


       //parm1
       exec sql
         select  dec (week_iso(current date+00  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+00  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm1   = nextyear*100 + nextweek;
       //parm2
       exec sql
         select  dec (week_iso(current date+07  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+07  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm2   = nextyear*100 + nextweek;

       //parm3
       exec sql
         select  dec (week_iso(current date+14  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+14  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm3   = nextyear*100 + nextweek;

       //parm4
       exec sql
         select  dec (week_iso(current date+21  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+21  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm4   = nextyear*100 + nextweek;

       //parm5
       exec sql
         select  dec (week_iso(current date+28  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+28  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm5   = nextyear*100 + nextweek;

       //parm6
       exec sql
         select  dec (week_iso(current date+35  day ), 2, 0)
                 into            :nextweek
                 from   qsys2/qsqptabl;
       exec sql
         select  dec (year(current date+35  day ), 4, 0)
                 into            :nextyear
                 from   qsys2/qsqptabl;
        eval     parm6   = nextyear*100 + nextweek;
       //liblist

       //Version V2  back03v2    heir raus später
       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(GANG/back03v2)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(GANG/back03v2)            ';
          exsr      SR_log;
       on-error;
          status='Error by clrpfm object (GANG/back03v2)           ';
          exsr      SR_log;
       endmon;

       //Version V2  back03v2    heir raus später
       exec sql
          CREATE TABLE gang/back03v2
          (ident     CHAR(15) CCSID 273,
           lieferant CHAR(10) CCSID 273,
           yearweek##  decimal(06, 0) ,
           value     decimal(12, 2))        ;
       //offene Bestellungen
       exec sql
           inserT into gang/back03v2
           SELECT eptenr, epLFNR ,
                  decimal(decimal(year
                   ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                  decimal(decimal(week_iso
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                       substr(EPBETE, 5, 2) concat '-' concat
                       substr(EPBETE, 7, 2)) )), 2, 0),
                  sum(epmeng)
           FROM bbep01     WHERE epfirm='01' and epbete > 0 and
           ( decimal(decimal(year
              ( date(substr(EPBETE, 1, 4) concat '-' concat
                substr(EPBETE, 5, 2) concat '-' concat
                substr(EPBETE, 7, 2)) )), 4, 0) *100 +
             decimal(decimal(week_iso
                ( date(substr(EPBETE, 1, 4) concat '-' concat
                  substr(EPBETE, 5, 2) concat '-' concat
                  substr(EPBETE, 7, 2)) )), 2, 0) > :curdate)
                           and
              ( decimal(decimal(year
                 ( date(substr(EPBETE, 1, 4) concat '-' concat
                   substr(EPBETE, 5, 2) concat '-' concat
                   substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                decimal(decimal(week_iso
                   ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 2, 0) < :maxdate)
                           and
             EPBEJJ not in (select #aebejj from we_checktr where
                            epbenr=#aebenr and epbepo=#aebepo)
           GROUP BY eptenr, epLFNR ,
                  decimal(decimal(year
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                  decimal(decimal(week_iso
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 2, 0);


       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(xxxxxxxxxx/available)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(TVRELWAECO/availableR)    ';
          exsr      SR_log;
       on-error;
          status='Error by clrpfm object (TVRELWAECO/availableR)   ';
          exsr      SR_log;
       endmon;



       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back01)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back01)             ';
       on-error;
          status='Error by clrpfm object (qtemp/back01)            ';
       endmon;

       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back01b)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back01b)            ';
       on-error;
          status='Error by clrpfm object (qtemp/back01b)           ';
       endmon;



       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back02)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back02)             ';
       on-error;
          status='Error by clrpfm object (qtemp/back02)            ';
       endmon;



       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back03)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back03)             ';
       on-error;
          status='Error by clrpfm object (qtemp/back03)            ';
       endmon;


       MONITOR;
       Wrk.var1 =
           'CLRPFM FILE(qtemp/back04)';
         cmd = %TrimR(Wrk.Var1);
         L      = %Len(Cmd);
         QCMDEXC(cmd: %len(cmd));
          status='CLRPFM successful FILE(qtemp/back04)             ';
       on-error;
          status='Error by clrpfm object (qtemp/back04)            ';
       endmon;

       //liblist
       MONITOR;
          Wrk.var1 =
              'ADDLIBLE LIB(DOMDATV7) POSITION(*LAST) ';
          cmd = %TrimR(Wrk.Var1);
          L      = %Len(Cmd);
          QCMDEXC(cmd: %len(cmd));
             error1 ='0';
          on-error;
             status='error ADDLIBLE LIB(DOMDATV7) POSITION(*LAST)        ';
             exsr      SR_log;
             error1 ='1';
       endmon;

       //liblist
       MONITOR;
          Wrk.var1 =
              'ADDLIBLE LIB(DOMCOMV7) POSITION(*LAST) ';
          cmd = %TrimR(Wrk.Var1);
          L      = %Len(Cmd);
          QCMDEXC(cmd: %len(cmd));
             error2 ='0';
          on-error;
             status='error ADDLIBLE LIB(DOMCOMV7) POSITION(*LAST)        ';
             exsr      SR_log;
             error2 ='1';
       endmon;



       //*************************************************************************************************************
       err_msg     = '1';
       NumSysTime = %Dec(%Time(): *ISO);
       //  If MyNumTime = NumSysTime;
       //  //2. Convert numeric Time (HHMMSS) into a real time
       //  RealTime = %Time(MyNumTime: *ISO);
       //  If RealTime = %Time();

       mydate  = %date();
       days    = %subdt( %date(): *days );
       months  = %subdt( %date(): *months );
       years   = %subdt( %date(): *years );
       eofyear = years*10000+12*100+31;
       nowdate = (%dec(%char(%date()- %days(1):*iso0):8:0));

       tomorrow  = %date() +  %days(01);
       twechsel  = %date() +  %days(01);
       tommonths = %subdt( %date() + %days(01): *months );

       §records=*zero;
       exec sql
         select count(*) into :§records
                FROM  TVRELWAECO/xxxxx;

       if §records <> *zero;
       endif;

       exec sql
         select  dec(DAYOFWEEK_iso(current date ), 1, 0)
                 into            :week
                 from   qsys2/qsqptabl;


       err_msg   = '0';

       //sql handling
         exec sql
                  whenever not found continue;
         exec sql
                  WHENEVER SQLWARNING continue;
         exec sql
                  WHENEVER SQLERROR  continue;

       endsr;

       //**************************************************************************
       //*vorher Stücklistenkalkulation
       //*-------------------------------------------------------------------------

       begsr sr_BACKORD;

         eval status ='Start callP RPMEXPECM                     ';
         exsr      SR_log;
         callP RPMEXPECM();
         eval status ='Ende  callP RPMEXPECM                     ';
         exsr      SR_log;

         eval status ='Start callP WE_CHECK                      ';
         exsr      SR_log;
         callP WE_CHECK();
         eval status ='Ende  callP WE_CHECK                      ';
         exsr      SR_log;

       //eval status ='Start callP EKBEST300C                    ';
       //exsr      SR_log;
       //callP EKBEST300C();
       //eval status ='Ende  callP EKBEST300C                    ';
       //exsr      SR_log;



       status=*blank;
       exec sql
        delete   from tvrelwaeco/backorders
        where tstamp > current timestamp -1 hour ;

       exec sql
          CREATE TABLE qtemp/back01
          (item      CHAR(15) CCSID 273,
           itemname  CHAR(40) CCSID 273,
           value     decimal(12, 2) ,
           pcs       decimal(12, 2))        ;

       exec sql
           inserT into qtemp/back01
           select item, char(' ', 40) itemname,
           dec(sum(wert), 12, 2 ) value,
           dec(sum(APGLMG), 12, 2 ) pcs
           FROM RPMEXPECM0
           WHERE YEAR# =year(current date - 0 day) and
                 ( week# =week(current date - 0 day) -1 or
                   week# =week(current date - 0 day) -1)  and
       //          week# =1                            )  and
                 akfirm ='01' and APAFST ='17' GROUP BY item;
       exec sql
          CREATE TABLE qtemp/back02
          (ident     CHAR(15) CCSID 273,
           lieferant CHAR(10) CCSID 273,
           year##    decimal(04, 0) ,
           week##    decimal(02, 0) ,
           value     decimal(12, 2))        ;

       exec sql
          CREATE TABLE qtemp/back01b
          (item      CHAR(15) CCSID 273,
           itemname  CHAR(40) CCSID 273,
           customer# CHAR(15) CCSID 273,
           customer  CHAR(40) CCSID 273,
           value     decimal(12, 2) ,
           pcs       decimal(12, 2))        ;

       exec sql
          CREATE TABLE qtemp/back03
          (ident     CHAR(15) CCSID 273,
           lieferant CHAR(10) CCSID 273,
           year##    decimal(04, 0) ,
           week##    decimal(02, 0) ,
           value     decimal(12, 2))        ;

       //Version V2  back03v2
       exec sql
          CREATE TABLE qtemp/back03v2
          (ident     CHAR(15) CCSID 273,
           lieferant CHAR(10) CCSID 273,
           yearweek##  decimal(06, 0) ,
           value     decimal(12, 2))        ;

       //we_checktr
       exec sql
           inserT into qtemp/back02
           SELECT #LBLBTENR, #AELFNR ,
                  decimal(decimal(year(DATELFTERM)), 4, 0),
                  decimal(decimal(week(DATELFTERM)), 2, 0),
                  sum(#LBLBBWMG )
           FROM we_checktr WHERE DAT001 = 0 and
           ((week(DATELFTERM)=week(current date)+0 or
             week(DATELFTERM)=week(current date)+1 or
             week(DATELFTERM)=week(current date)+2 or
             week(DATELFTERM)=week(current date)+3 or
             week(DATELFTERM)=week(current date)+4 or
             week(DATELFTERM)=week(current date)+5 or
             week(DATELFTERM)=week(current date)+6 ) and
            (year(DATELFTERM)=year(current date) or
             year(DATELFTERM)>year(current date) ))
            GROUP BY #LBLBTENR, #AELFNR,
            decimal(decimal(year(DATELFTERM)), 4, 0),
            decimal(decimal(week(DATELFTERM)), 2, 0);

       //offene Bestellungen
       exec sql
           inserT into qtemp/back03
           SELECT eptenr, epLFNR ,
                  decimal(decimal(year
                   ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0),
                  decimal(decimal(week
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                       substr(EPBETE, 5, 2) concat '-' concat
                       substr(EPBETE, 7, 2)) )), 2, 0),
                  sum(epmeng)
           FROM bbep01     WHERE epfirm='01' and epbete > 0 and
           ((week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+0 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+1 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+2 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+3 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+4 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+5 or
             week( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  =week(current date)+6 ) and
            (year( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)) )  = year(current date) or
             year( date(substr(EPBETE, 1, 4) concat '-' concat
                    substr(EPBETE, 5, 2) concat '-' concat
                    substr(EPBETE, 7, 2)))   > year(current date)))
             and
             EPBEJJ not in (select #aebejj from we_checktr where
                            epbenr=#aebenr and epbepo=#aebepo)
           GROUP BY eptenr, epLFNR ,
                  decimal(decimal(year
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0),
                  decimal(decimal(week
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 2, 0);

       //offene Bestellungen
       exec sql
           inserT into qtemp/back03v2
           SELECT eptenr, epLFNR ,
                  decimal(decimal(year
                   ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                  decimal(decimal(week_iso
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                       substr(EPBETE, 5, 2) concat '-' concat
                       substr(EPBETE, 7, 2)) )), 2, 0),
                  sum(epmeng)
           FROM bbep01     WHERE epfirm='01' and epbete > 0 and
           ( decimal(decimal(year
              ( date(substr(EPBETE, 1, 4) concat '-' concat
                substr(EPBETE, 5, 2) concat '-' concat
                substr(EPBETE, 7, 2)) )), 4, 0) *100 +
             decimal(decimal(week_iso
                ( date(substr(EPBETE, 1, 4) concat '-' concat
                  substr(EPBETE, 5, 2) concat '-' concat
                  substr(EPBETE, 7, 2)) )), 2, 0) > :curdate)
                           and
              ( decimal(decimal(year
                 ( date(substr(EPBETE, 1, 4) concat '-' concat
                   substr(EPBETE, 5, 2) concat '-' concat
                   substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                decimal(decimal(week_iso
                   ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 2, 0) < :maxdate)
                           and
             EPBEJJ not in (select #aebejj from we_checktr where
                            epbenr=#aebenr and epbepo=#aebepo)
           GROUP BY eptenr, epLFNR ,
                  decimal(decimal(year
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 4, 0) *100 +
                  decimal(decimal(week_iso
                     ( date(substr(EPBETE, 1, 4) concat '-' concat
                     substr(EPBETE, 5, 2) concat '-' concat
                     substr(EPBETE, 7, 2)) )), 2, 0);

       //für offene Produktionsaufträge
       exec sql
          CREATE TABLE qtemp/back04
          (ident     CHAR(15) CCSID 273,
           lieferant CHAR(10) CCSID 273,
           year##    decimal(04, 0) ,
           week##    decimal(02, 0) ,
           value     decimal(12, 2))        ;

       //offene Produktionsaufträge
       exec sql
           inserT into qtemp/back04
           SELECT UKtenr, '000000    ' uklfr,
                  decimal(decimal(year
                   ( date(substr(UKPREN, 1, 4) concat '-' concat
                     substr(UKPREN, 5, 2) concat '-' concat
                     substr(UKPREN, 7, 2)) )), 4, 0),
                  decimal(decimal(week
                     ( date(substr(UKPREN, 1, 4) concat '-' concat
                       substr(UKPREN, 5, 2) concat '-' concat
                       substr(UKPREN, 7, 2)) )), 2, 0),
                  sum(UKPPMG - UKRMMG)
           FROM pauk01     WHERE ukfirm='01' and
                           UKPPAT='300' and UKppst<>'28' and UKPRE1=0 and
           ((week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+0 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+1 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+2 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+3 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+4 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+5 or
             week( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  =week(current date)+6 ) and
            (year( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)) )  = year(current date) or
             year( date(substr(UKPREN, 1, 4) concat '-' concat
                    substr(UKPREN, 5, 2) concat '-' concat
                    substr(UKPREN, 7, 2)))   > year(current date)))
           GROUP BY uktenr,
                  decimal(decimal(year
                     ( date(substr(UKPREN, 1, 4) concat '-' concat
                     substr(UKPREN, 5, 2) concat '-' concat
                     substr(UKPREN, 7, 2)) )), 4, 0),
                  decimal(decimal(week
                     ( date(substr(UKPREN, 1, 4) concat '-' concat
                     substr(UKPREN, 5, 2) concat '-' concat
                     substr(UKPREN, 7, 2)) )), 2, 0);


       pstamp = %timestamp('2016-03-14-23.00.34.125492');

