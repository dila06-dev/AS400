       //Aufbau
        exec sql
           insert into tvrelwaeco/backorders
           SELECT char(' ', 1) fkt, ITEM, ITEMNAME,' ', ' ', ' ',
                  decimal(0, 12, 2) backcurv,
                  decimal(0, 12, 0) backcurp,   decimal(0, 12, 2) maxstock,
                                     char(' ', 40 ) rootcause,
           char(' ', 10 ) lieferant,char(' ', 40 ) supname,
           decimal(0, 12, 0) forecast,  decimal(0, 12, 2) onstock,
           decimal(0, 10, 0) arrivalw1, decimal(0, 10, 0) arrivalw2,
           decimal(0, 10, 0) arrivalw3, decimal(0, 10, 0) arrivalw4,
           decimal(0, 10, 0) arrivalw5, decimal(0, 10, 0) arrivalw6,
           char(' ', 5) disponent, char(' ', 5), 0,00 , 0 , char(' ', 60) info,
           current timestamp tstamp, 0
           from qtemp/back01;

       //supplier code
        exec sql
           update TVRELWAECO/backorders a set a.lieferant =
           (select b.lieferant  from qtemp/back02 b where ident =item and
           (( week##=week(current date)+0 ) and
             (year##=year(current date) or
              year##=year(current date) +1 ))
            and tstamp > current timestamp -1 hour)
           where exists
           (select b.lieferant  from qtemp/back02 b where ident =item and
           (( week##=week(current date)+0 ) and
             (year##=year(current date) or
              year##=year(current date) +1 ))
            and tstamp > current timestamp -1 hour);

