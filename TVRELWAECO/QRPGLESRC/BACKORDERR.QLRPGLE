     d RPMEXPECM       PR                  ExtPgm('RPMEXPECM')
       // ______________________________________________________________________
       // Sicherung WE_CHECK
     d WE_CHECK        PR                  ExtPgm('WE_CHECK')
       // ______________________________________________________________________
       // BACKORDERR      PR                  ExtPgm('BACKORDERR')
       // ______________________________________________________________________
       // define data areas
       // ______________________________________________________________________
     D #swapc          s             08a   dtaara
     D JOB_R_run       s             01a   dtaara

      //------------------------------------------------------------------------
