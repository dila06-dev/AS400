      // qcmdexc
      //------------------------------------------------------------------------
     D Wrk             DS                  Qualified inz
     D Var1                         460A   inz(' ')
     D L               s              9  0
     D
     D QCMDEXC         PR                  ExtPgm('QCMDEXC')
     D cmd                        32702A   const options(*varsize)
     D len                           15P 5 const

     D cmd             s            460A   varying

      // dummy512
      //------------------------------------------------------------------------
      // p_md            s            001a   inz
      //                                     dim(256)
     D p_md            s            256a   inz
     D p_MSG           s              7a   inz
     D p_MSGF          s             10a   inz
     D p_PRINT         s             10a   inz
     D p_OUTFIL        s             10a   inz
     D p_LIB           s             10a   inz
     D P_REPADD        s             10a   inz

     D §records        s              9s 0 inz
     D §records2       s              9s 0 inz
     D §quantity1      s             10s 3 inz
     D §quantity2      s             10s 3 inz
     D §calc           s              6s 3 inz
     D ##week          s              2s 0 inz
     D ##month         s              2s 0 inz

      // qmhsndpm
      // ______________________________________________________________________
     D MessageID       s              7A   inz
     D QualMsgF        s             20A   inz
     D MsgData         s            256A   inz
     D MsgDtaLen       s             10I 0 inz
     D MsgType         s             10A   inz


      // internal
      // ______________________________________________________________________
     D status          s            132A   inz
     D err_msg         s              1a   inz
     D #error          s              1a   inz
     D #openquan       s             13s 4 inz
     D #division       s             10a   inz
     D #expected       s             13s 4 inz
     D #run            s              1a   inz
     D #dirmail        s              1a   inz
     D checkd          s              8s 0 inz
     D checkx          s              8s 0 inz
     D p               s             15p 0

     D suffix          s              6A   inz
     D transfer        s             30A   inz
     D string_file     s             60A   inz
     d NumSysTime      s              6s 0
     d myDate          s               d
     d tomorrow        s               d
     d twechsel        s               d
     d days            s              2s 0
     d months          s              2s 0
     d years           s              4s 0
     d tommonths       s              2s 0
     d eofyear         s              8s 0
     d nowdate         s              8s 0
     Dweek             s              1s 0
     DGoodDateV        S              1a
     DGoodDateB        S              1a
     Derror1           s              1a   inz
     Derror2           s              1a   inz
     Derror3           s              1a   inz
     Derror4           s              1a   inz
     Derror5           s              1a   inz
     Dpstamp           s               z   inz
     D#ERRORS          s             60a
     DDate_in_V        S               D   DATFMT(*iso)
     DDate_in_B        S               D   DATFMT(*iso)
     D p_inFIL         s             24a
     d curweek         s              2s 0
     d maxweek         s              2s 0
     d curyear         s              4s 0
     d maxyear         s              4s 0
     d curdate         s              6s 0
     d maxdate         s              6s 0
     d nextweek        s              2s 0
     d nextyear        s              6s 0
     d parm1           s              6s 0
     d parm2           s              6s 0
     d parm3           s              6s 0
     d parm4           s              6s 0
     d parm5           s              6s 0
     d parm6           s              6s 0

     D §search         s              1a   inz
     D §string         s            100a   inz
